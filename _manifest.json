{
  "manifest_version": 2,
  "version": "1.0.1",
  "name": "印象簿（亲密度与人际印象管理）",
  "description": "让 Bot 全局识别每位群成员，维护好感度与印象条目，支持向量检索与上下文注入；好感度由 Bot 自动评估微调，主人可通过 QQ 号认证的指令随时调整",
  "author": {
    "name": "HVBNM-AFK",
    "url": "https://github.com/HVBNM-AFK"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/HVBNM-AFK/impression-book",
    "homepage": "https://github.com/HVBNM-AFK/impression-book",
    "documentation": "https://github.com/HVBNM-AFK/impression-book/blob/main/README.md",
    "issues": "https://github.com/HVBNM-AFK/impression-book/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "llm.embed",
    "llm.generate",
    "maisaka.context.append"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.hvbnm-afk.impression-book"
}
